# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=data/auth.sqlite

# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord callback: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server-only loopback Controller; never use NEXT_PUBLIC_ for credentials
CONTROLLER_INTERNAL_URL=http://127.0.0.1:5081
CONTROLLER_SERVICE_CREDENTIAL=
CONTROLLER_AGENT_URL=https://localhost:7443
CONTROLLER_DATABASE_PATH=data/controller.sqlite

# Optional Controller public-IP lookup used to build renter connect addresses. Must be an absolute
# HTTPS URL (for example https://api.ipify.org); leave empty to disable the lookup.
CONTROLLER_PUBLIC_IP_ENDPOINT=https://api.ipify.org
# Fleet-wide Sunshine management credential encryption key: base64 of exactly 32 random bytes.
# Required only when administrators manage the fleet credential; leave empty to disable storage.
# Generate once, store only in .env.local, and never commit or log it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTROLLER_SUNSHINE_CREDENTIAL_KEY=

# Agent installer command stays hidden until the package SHA-256 and trust root are configured.
# Base/package URLs may use localhost HTTP for same-machine tests; the Controller URL must stay HTTPS.
AGENT_INSTALL_ENABLED=false
AGENT_INSTALL_BASE_URL=http://localhost:3000
AGENT_PACKAGE_URL=
AGENT_PACKAGE_SHA256=
AGENT_CONTROLLER_URL=
# Required for localhost/loopback and Controller hostnames; a private literal Controller IPv4 can be derived.
# Must be the single private IPv4 address the child PCs see as the Controller source; never use 127.0.0.1, public IP, or CIDR.
AGENT_VNC_ALLOWED_SOURCE_IP=
# Optional browser-facing VNC WebSocket endpoint for reverse-proxied deployments. Must be an absolute
# wss:// URL whose path is exactly /admin/vnc (no query/hash), e.g. wss://example.com/admin/vnc.
# Leave empty to derive wss://<AGENT_CONTROLLER_URL host>/admin/vnc (browser must reach that host).
VNC_PUBLIC_WS_URL=
# Optional: when the web runs via the custom server (`node server.mjs`), it proxies
# wss://<web-origin>/admin/vnc to this Controller HTTPS origin (no port 7443 exposure needed).
VNC_PROXY_TARGET=https://127.0.0.1:7443
# Optional SNI override when the Controller certificate CN/SAN differs from VNC_PROXY_TARGET host.
VNC_PROXY_SERVERNAME=
AGENT_TRUST_ROOT_THUMBPRINT=
AGENT_UPDATE_ENABLED=false

# Top-up provider base URLs (server-only; never use NEXT_PUBLIC_)
EASYSLIP_API_URL=https://api.easyslip.com
SLIPOK_API_URL=https://api.slipok.com
TRUEMONEY_ANGPAO_API_URL=https://tmn-angpao.pages.dev/api

# Optional: base64 of exactly 32 random bytes to encrypt stored top-up API keys.
# If unset, the server derives a key from BETTER_AUTH_SECRET / data/.auth-secret,
# or creates data/.topup-secret (0600). Back up the DB and secret sidecar together.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOPUP_SETTINGS_KEY=
# Optional absolute directory for uploaded slip images; defaults beside the auth DB.
TOPUP_SLIP_DIR=
