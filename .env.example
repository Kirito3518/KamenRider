# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=data/auth.sqlite

# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord callback: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server-only loopback Controller; never use NEXT_PUBLIC_ for credentials
CONTROLLER_INTERNAL_URL=http://127.0.0.1:5081
CONTROLLER_SERVICE_CREDENTIAL=

# Agent installer command is hidden until a qualified package is published.
# Use an HTTPS origin reachable from every client; localhost is for same-machine testing only.
AGENT_INSTALL_ENABLED=false
AGENT_INSTALL_BASE_URL=http://localhost:3000
AGENT_PACKAGE_URL=
AGENT_PACKAGE_SHA256=
AGENT_CONTROLLER_URL=
AGENT_TRUST_ROOT_THUMBPRINT=
