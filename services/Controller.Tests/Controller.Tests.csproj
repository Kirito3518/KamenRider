<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\AgentMetadataFixture\**\*.cs" />
    <Compile Remove="Fixtures\LegacyAgentMetadataFixture\**\*.cs" />
    <Compile Remove="Fixtures\AgentVersionTwo\**\*.cs" />
    <Compile Remove="Fixtures\AgentVersionThree\**\*.cs" />
    <Compile Remove="Fixtures\AgentPackageProtocolTwo\**\*.cs" />
    <Compile Remove="Fixtures\LegacyInstalledAgent\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ControllerProjectPath</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\..\Controller\Controller.csproj</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LegacyInstalledAgentOutputPath</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\Fixtures\LegacyInstalledAgent\bin\$(Configuration)\net10.0\win-x64</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMaintenance\AgentMaintenance.csproj" />
    <ProjectReference Include="..\AgentPackage\AgentPackage.csproj" />
    <ProjectReference Include="..\Agent\Agent.csproj" />
    <ProjectReference Include="Fixtures\AgentMetadataFixture\AgentMetadataFixture.csproj" />
    <ProjectReference Include="Fixtures\LegacyAgentMetadataFixture\LegacyAgentMetadataFixture.csproj" />
    <ProjectReference Include="Fixtures\LegacyInstalledAgent\LegacyInstalledAgent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures\AgentVersionTwo\AgentVersionTwo.csproj" />
    <ProjectReference Include="Fixtures\AgentVersionThree\AgentVersionThree.csproj" />
    <ProjectReference Include="..\Controller\Controller.csproj" />
  </ItemGroup>

</Project>
