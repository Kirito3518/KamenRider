# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp-tests/

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/data/

# local SQLite databases
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET service outputs and machine-local configuration
**/bin/
**/obj/
**/obj-*/
.restore-epoch-tests/
public/agent/AgentPackage.zip
public/agent/AgentPackage.sha256
/agent-release-artifacts/
services/**/appsettings.Local.json
services/**/secrets/
services/**/data/
*.pfx
*.p12

# Controller persistence source (Windows paths are case-insensitive)
!services/Controller/Data/
!services/Controller/Data/**
